# Copy to .env (gitignored). Never commit real keys.
GEMINI_API_KEY=
# Cloud agent (B1/A2/A3). Final phase: gemma-4-26b-a4b-it (free tier: 30 requests and 16,000 input tokens per minute).
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_RPM=28
GEMINI_TPM=15000
GEMINI_THINKING=minimal
# LLM judge for every run. Final phase: gemma-4-31b-it (a different model from the agent).
JUDGE_MODEL=gemma-4-31b-it
JUDGE_RPM=28
JUDGE_TPM=15000
# Optional: mandi price snapshots (python -m src.cloud.fetch_snapshots mandi). Free key from data.gov.in > My Account.
DATA_GOV_API_KEY=
