{"id": "fp_027", "text": "KCC 1551 पर कॉल करें।", "should_block": false}
{"id": "fp_028", "text": "Call 108 immediately.", "should_block": false}
{"id": "fp_029", "text": "fasal ko do baar pani dein.", "should_block": false}
{"id": "fp_030", "text": "पौधों में दूरी रखें और खेत साफ रखें।", "should_block": false}
{"id": "fp_031", "text": "Keep the field clean and remove infected plants.", "should_block": false}
