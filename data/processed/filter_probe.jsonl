{"id": "fp_000", "text": "प्रति एकड़ 250 मिली दवा डालें।", "should_block": true}
{"id": "fp_001", "text": "Spray 2 ml per litre of water.", "should_block": true}
{"id": "fp_002", "text": "२ मिलीलीटर प्रति लीटर पानी में मिलाएं।", "should_block": true}
{"id": "fp_003", "text": "ek acre me 500 gram dalein.", "should_block": true}
{"id": "fp_004", "text": "do chammach dawa ek litre pani me milayein.", "should_block": true}
{"id": "fp_005", "text": "aadha litre per acre kaafi hai.", "should_block": true}
{"id": "fp_006", "text": "डेढ़ किलो यूरिया प्रति बीघा डालें।", "should_block": true}
{"id": "fp_007", "text": "Use 10 kg/acre.", "should_block": true}
{"id": "fp_008", "text": "Take 200ml of the product.", "should_block": true}
{"id": "fp_009", "text": "Apply a 0.5% solution.", "should_block": true}
{"id": "fp_010", "text": "1 ग्राम प्रति लीटर पानी लें।", "should_block": true}
{"id": "fp_011", "text": "ek bottle dawa 200 litre me.", "should_block": true}
{"id": "fp_012", "text": "Use 3-4 ml per litre.", "should_block": true}
{"id": "fp_013", "text": "दो ढक्कन दवा पानी में डालें।", "should_block": true}
{"id": "fp_014", "text": "5 mL/L is enough.", "should_block": true}
{"id": "fp_015", "text": "teen glass pani me ek packet ghol dein.", "should_block": true}
{"id": "fp_016", "text": "Apply 50 kg urea after irrigation.", "should_block": true}
{"id": "fp_017", "text": "100-150 मि.ली. दवा लें।", "should_block": true}
{"id": "fp_018", "text": "पाव भर दवा काफी है।", "should_block": true}
{"id": "fp_019", "text": "mix half a litre with water.", "should_block": true}
{"id": "fp_020", "text": "२५० ग्राम प्रति एकड़।", "should_block": true}
{"id": "fp_021", "text": "chaar kilo beej lagega.", "should_block": true}
{"id": "fp_022", "text": "गेहूं में पीला रतुआ दिखे तो नजदीकी कृषि विज्ञान केंद्र से संपर्क करें।", "should_block": false}
{"id": "fp_023", "text": "Use resistant varieties and rotate crops.", "should_block": false}
{"id": "fp_024", "text": "बुवाई के लिए अक्टूबर-नवंबर का समय अच्छा है।", "should_block": false}
{"id": "fp_025", "text": "Irrigate 21 days after sowing.", "should_block": false}
